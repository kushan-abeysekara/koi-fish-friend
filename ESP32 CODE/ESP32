#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// ===================== LCD SETUP =====================
LiquidCrystal_I2C lcd(0x27, 20, 4);   // Use your I2C address (0x27 or 0x3F)

// ===================== PIN MAPPING =====================
#define ZMPT_PIN   34     // Voltage sensor analog input
#define ACS_PIN    35     // Current sensor analog input
#define RELAY_PIN  25     // Relay control output

// ===================== CALIBRATION =====================
// Adjust after testing with a multimeter
const float ADC_MAX = 4095.0;       // ESP32 ADC is 12-bit (0–4095)
const float V_REF = 3.3;            // Reference voltage

// ZMPT calibration constants
float V_calibration = 230.0 / 2048.0;  // Adjust after calibration
float voltageOffset = 0.0;

// ACS712 calibration constants
float I_calibration = 30.0 / 2048.0;   // For ACS712-30A (adjust for your version)
float currentOffset = 2048.0;          // Midpoint for ACS712

// ===================== VOLTAGE SAFETY RANGE =====================
const float V_SAFE_MIN = 210.0;
const float V_SAFE_MAX = 250.0;

// ===================== VARIABLES =====================
float voltage = 0, current = 0, power = 0, energyWh = 0;
unsigned long lastSample = 0;
unsigned long lastDisplay = 0;

// ===================== SETUP =====================
void setup() {
  Serial.begin(115200);
  Wire.begin(21, 23); // SDA, SCL

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("IoT Aquaculture");
  lcd.setCursor(0, 1);
  lcd.print("Energy Monitoring");
  delay(2000);
  lcd.clear();

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, HIGH); // Start with relay ON

  Serial.println("System started...");
  Serial.println("----------------------------");
}

// ===================== HELPER FUNCTIONS =====================
float readVoltage(int pin, float scale, int samples = 10) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(2);
  }
  float raw = sum / (float)samples;
  float voltage = (raw - 2048.0) * scale;
  return abs(voltage);
}

float readCurrent(int pin, float scale, int samples = 10) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(2);
  }
  float raw = sum / (float)samples;
  float current = (raw - currentOffset) * scale;
  return abs(current);
}

// ===================== MAIN LOOP =====================
void loop() {
  unsigned long now = millis();
  float deltaT = (now - lastSample) / 1000.0; // seconds since last read
  lastSample = now;

  // --- Sensor readings (averaged for noise reduction)
  voltage = readVoltage(ZMPT_PIN, V_calibration);
  current = readCurrent(ACS_PIN, I_calibration);
  power = voltage * current;
  energyWh += (power * deltaT) / 3600.0; // integrate over time

  // --- Voltage protection logic
  if (voltage < V_SAFE_MIN || voltage > V_SAFE_MAX) {
    digitalWrite(RELAY_PIN, LOW);  // Turn OFF load
    Serial.println("⚠️ Voltage out of safe range – Relay OFF");
  } else {
    digitalWrite(RELAY_PIN, HIGH); // Normal operation
  }

  // --- Debug log
  Serial.printf("V=%.2fV  I=%.2fA  P=%.2fW  E=%.2fWh\n",
                voltage, current, power, energyWh);

  // --- LCD update every 1s
  if (now - lastDisplay >= 1000) {
    lastDisplay = now;
    lcd.setCursor(0, 0);
    lcd.print("Voltage:");
    lcd.setCursor(10, 0);
    lcd.print(voltage, 1);
    lcd.print("V  ");

    lcd.setCursor(0, 1);
    lcd.print("Current:");
    lcd.setCursor(10, 1);
    lcd.print(current, 2);
    lcd.print("A  ");

    lcd.setCursor(0, 2);
    lcd.print("Power:");
    lcd.setCursor(10, 2);
    lcd.print(power, 1);
    lcd.print("W  ");

    lcd.setCursor(0, 3);
    lcd.print("Energy:");
    lcd.setCursor(10, 3);
    lcd.print(energyWh, 1);
    lcd.print("Wh ");
  }

  delay(100);
}