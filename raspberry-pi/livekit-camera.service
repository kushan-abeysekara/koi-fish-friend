[Unit]
Description=LiveKit Camera Bridge for Koi Fish Monitoring
After=network-online.target
Wants=network-online.target
# Start after the existing Flask camera server
After=realtime-streaming.service

[Service]
Type=simple
User=koi
WorkingDirectory=/home/koi/livekit-camera
EnvironmentFile=/home/koi/livekit-camera/.env
ExecStart=/home/koi/livekit-camera/venv/bin/python3 /home/koi/livekit-camera/livekit_bridge.py
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
